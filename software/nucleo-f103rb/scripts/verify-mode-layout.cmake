if(NOT DEFINED ELF)
  message(FATAL_ERROR "Provide -DELF=<linked F103RB ELF>")
endif()
execute_process(COMMAND arm-none-eabi-nm -n "${ELF}" OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Cannot read linked ARM symbols")
endif()
foreach(name __calibration_store_start__ __calibration_store_end__ __mode_store_start__ __mode_store_end__ _sidata _sdata _edata _estack flash_operation)
  string(REGEX MATCH "([0-9a-fA-F]+) [A-Za-z] ${name}[\r\n]" found "${symbols}")
  if(NOT found)
    message(FATAL_ERROR "Missing symbol ${name}")
  endif()
  math(EXPR ${name}_value "0x${CMAKE_MATCH_1}")
endforeach()
math(EXPR image_end "${_sidata_value}+${_edata_value}-${_sdata_value}")
math(EXPR settings_start "0x0801f800")
math(EXPR settings_end "0x08020000")
math(EXPR ram_start "0x20000000")
math(EXPR ram_end "0x20005000")
if(NOT __mode_store_start___value EQUAL settings_start OR NOT __mode_store_end___value EQUAL settings_end)
  message(FATAL_ERROR "Persistent Flash boundaries do not match driver")
endif()
math(EXPR calibration_start "0x0801f000")
if(NOT __calibration_store_start___value EQUAL calibration_start OR NOT __calibration_store_end___value EQUAL settings_start)
  message(FATAL_ERROR "Calibration Flash boundaries do not match driver")
endif()
if(image_end GREATER calibration_start OR NOT _estack_value EQUAL ram_end)
  message(FATAL_ERROR "Application/stack crosses reserved memory limits")
endif()
if(flash_operation_value LESS ram_start OR flash_operation_value LESS _sdata_value OR
   NOT flash_operation_value LESS _edata_value OR _edata_value GREATER ram_end)
  message(FATAL_ERROR "Flash programming routine is not in startup-copied SRAM")
endif()
execute_process(COMMAND arm-none-eabi-objdump -d --disassemble=flash_operation "${ELF}"
  OUTPUT_VARIABLE assembly RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR assembly MATCHES "[ \t]blx?[ \t]")
  message(FATAL_ERROR "SRAM Flash operation calls another routine; inspect busy-time fetch safety")
endif()
message(STATUS "Settings layout PASS: independent calibration + mode journals (two 1KiB pages each), no application overlap, copied SRAM Flash routine without external calls, aligned end-of-RAM MSP")
