# Copy this file to .env before the first run. Use an absolute WSL path.
YERTLE_HOST_ROOT=/home/your-name/Desktop/yertle-isaaclab
HOST_UID=1000
HOST_GID=1000
YERTLE_REPOSITORY_URL=https://github.com/MainForm/yertle.git
YERTLE_GIT_REF=feature/isaac-lab-rl-locomotion

# Pinned to the existing yertle-isaac container versions.
ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:5.1.0
ISAACLAB_VERSION=2.3.2

TRAIN_TASK=flat
TRAIN_NUM_ENVS=1024
TRAIN_MAX_ITERATIONS=2000
# Standing + current raw-2048 API seated reference (+75 thigh / -160 shin), 50/50.
# Current 0/+34/-85 standing action/observation reference; new policies only.
# Explicit simulation-only limit expansion; command distribution is unchanged.
# Clear this value to retain legacy standing-only reset randomization.
TRAIN_EXTRA_ARGS=--signed-joint-reference --reset-standing-pose-json configs/standing_api_reference.json --reset-pose-json configs/seated_api_reference.json --extend-reset-pose-limits

# In-container checkpoint path for the optional headless play service.
PLAY_TASK=flat
PLAY_CHECKPOINT=
PLAY_NUM_ENVS=1
PLAY_STEPS=600
PLAY_RENDERING_MODE=performance
PLAY_HEADLESS=1
PLAY_VIDEO=0
PLAY_VIDEO_LENGTH=400
# Match the new trained reference. Clear for legacy checkpoints; never assume
# v6.4/v6.5 or other reference-angle checkpoints are interchangeable.
PLAY_EXTRA_ARGS=--signed-joint-reference --start-pose default
